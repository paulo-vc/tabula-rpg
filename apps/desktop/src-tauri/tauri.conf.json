{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tabula RPG",
  "version": "0.1.0",
  "identifier": "io.github.paulovc.tabularpg",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @tabula/web dev",
    "beforeBuildCommand": "pnpm --filter @tabula/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Tabula RPG",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss: https://cdn.jsdelivr.net https://raw.githubusercontent.com; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "shortDescription": "Fichas de RPG de mesa com sincronização em tempo real",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
